{
  "name": "openparlor",
  "version": "0.1.0",
  "description": "Party games for the room you are in: a TV (or any big screen) plus everyone's phones, on your own network.",
  "license": "MIT",
  "keywords": [
    "party-games",
    "local-multiplayer",
    "websocket",
    "pwa",
    "quiz",
    "self-hosted",
    "trivia",
    "tv",
    "family",
    "classroom"
  ],
  "private": true,
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning server/index.js",
    "validate": "node scripts/validate-content.js",
    "backup": "node --disable-warning=ExperimentalWarning scripts/backup.js",
    "test": "node --disable-warning=ExperimentalWarning --test",
    "cert": "node scripts/make-cert.js",
    "icons": "node scripts/make-icons.js",
    "licenses": "node scripts/licenses.js",
    "lint": "eslint ."
  },
  "dependencies": {
    "qrcode": "^1.5.4",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "globals": "^17.14.0"
  },
  "engines": {
    "node": ">=22.13"
  }
}
